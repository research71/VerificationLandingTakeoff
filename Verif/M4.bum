        <org.eventb.core.action name="." org.eventb.core.assignment="depRwy(aircraft) ≔ runway" org.eventb.core.label="act6"/>
        <org.eventb.core.action name="1" org.eventb.core.assignment="readyTime ≔ {aircraft} ⩤ readyTime" org.eventb.core.label="act9"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd4" org.eventb.core.predicate="∀ b · b ∈ aircrafts_in_TMA ∧ statusof(b) = ExecutedT ∧ b ∈ dom(readyTime)&#13;&#10;           ∧ b ∈ dom(clearanceT) ∧ clearanceT(b) = runway&#13;&#10;         ⇒ readyTime(b) ≥ readyTime(aircraft)"/>
        <org.eventb.core.guard name="internal4" org.eventb.core.label="grd9" org.eventb.core.predicate="brandof(aircraft) ∈ WTC ∧ aircraft ∉ dom(depTime) ∧ (runway ∈ dom(lastDepTime) ⇒ runway ∈ dom(lastDepBrand))"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd5" org.eventb.core.predicate="runway ∉ dom(lastDepTime)&#13;&#10;         ∨ current_time ≥ lastDepTime(runway) + DepDepSep(lastDepBrand(runway) ↦ brandof(aircraft))"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd6" org.eventb.core.predicate="runway ∉ dom(lastlandingtime)&#13;&#10;         ∨ current_time ≥ lastlandingtime(runway) + RwySep"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="*1" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Terminating_takingoff">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Terminating_takingoff"/>
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="runway"/>
        <org.eventb.core.parameter name="(" org.eventb.core.identifier="aircraft"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd1" org.eventb.core.predicate="aircraft ∈ aircrafts_in_TMA ∧ statusof(aircraft) = Takingoff"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd2" org.eventb.core.predicate="runway ∈ RUNWAY ∧ curr_RW_status(runway) = Unavailable ∧ curr_RWL_status(runway) = ON"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="statusof(aircraft) ≔ TerminatedT" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="," org.eventb.core.assignment="curr_RW_status(runway) ≔ Available " org.eventb.core.label="act2"/>
        <org.eventb.core.action name="-" org.eventb.core.assignment="curr_RWL_status(runway) ≔ OFF" org.eventb.core.label="act3"/>
        <org.eventb.core.guard name="'" org.eventb.core.label="grd3" org.eventb.core.predicate="aircraft ∈ dom(clearanceT) ∧ runway = clearanceT(aircraft)"/>
        <org.eventb.core.guard name="0" org.eventb.core.label="grd5" org.eventb.core.predicate="durationT ∈ 60‥90"/>
        <org.eventb.core.guard name="3" org.eventb.core.label="grd6" org.eventb.core.predicate="aircraft ∈ dom(depTime)"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="clearanceT ≔ {aircraft} ⩤ clearanceT" org.eventb.core.label="act4"/>
        <org.eventb.core.guard name="." org.eventb.core.label="grd4" org.eventb.core.predicate="current_time ≥ depTime(aircraft) + durationT "/>
        <org.eventb.core.parameter name="/" org.eventb.core.identifier="durationT"/>
        <org.eventb.core.action name="1" org.eventb.core.assignment="lastDepTime(runway)≔ current_time" org.eventb.core.label="act5"/>
        <org.eventb.core.action name="2" org.eventb.core.assignment="lastDepBrand(runway) ≔ brandof(aircraft)" org.eventb.core.label="act6"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="*2" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Departing">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Departing"/>
        <org.eventb.core.parameter name="(" org.eventb.core.identifier="aircraft"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd1" org.eventb.core.predicate="aircraft ∈ aircrafts_in_TMA ∧ statusof(aircraft) = TerminatedT"/>
        <org.eventb.core.action name="*" org.eventb.core.assignment="aircrafts_in_TMA ≔ aircrafts_in_TMA ∖ {aircraft}" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="statusof ≔ {aircraft} ⩤ statusof" org.eventb.core.label="act2"/>
        <org.eventb.core.action name="internal1" org.eventb.core.assignment="entryTMAOf    ≔ {aircraft} ⩤ entryTMAOf" org.eventb.core.label="act3"/>
        <org.eventb.core.action name="internal2" org.eventb.core.assignment="tmaEntryTime  ≔ {aircraft} ⩤ tmaEntryTime" org.eventb.core.label="act4"/>
        <org.eventb.core.action name="." org.eventb.core.assignment="ETA≔ {aircraft} ⩤ ETA" org.eventb.core.label="act5"/>
        <org.eventb.core.action name="/" org.eventb.core.assignment="legOf         ≔ {aircraft} ⩤ legOf" org.eventb.core.label="act6"/>
        <org.eventb.core.action name="internal4" org.eventb.core.assignment="legEntryTime  ≔ {aircraft} ⩤ legEntryTime" org.eventb.core.label="act7"/>
        <org.eventb.core.action name="1" org.eventb.core.assignment="legIndex      ≔ {aircraft} ⩤ legIndex" org.eventb.core.label="act8"/>
        <org.eventb.core.action name="2" org.eventb.core.assignment="legPointTime  ≔ {aircraft} ⩤ legPointTime" org.eventb.core.label="act9"/>
        <org.eventb.core.action name="3" org.eventb.core.assignment="acLevel       ≔ {aircraft} ⩤ acLevel" org.eventb.core.label="act10"/>
        <org.eventb.core.action name="4" org.eventb.core.assignment="mergeTime     ≔ {aircraft} ⩤ mergeTime" org.eventb.core.label="act11"/>
        <org.eventb.core.action name="5" org.eventb.core.assignment="plannedRunway ≔ {aircraft} ⩤ plannedRunway" org.eventb.core.label="act12"/>
        <org.eventb.core.action name="6" org.eventb.core.assignment="Threshold     ≔ {aircraft} ⩤ Threshold" org.eventb.core.label="act13"/>
        <org.eventb.core.action name="7" org.eventb.core.assignment="TouchdownTime ≔ {aircraft} ⩤TouchdownTime" org.eventb.core.label="act16"/>
        <org.eventb.core.action name="," org.eventb.core.assignment="cpOf≔ {aircraft} ⩤ cpOf  " org.eventb.core.label="act14"/>
        <org.eventb.core.action name="-" org.eventb.core.assignment="cpTime≔ {aircraft} ⩤  cpTime" org.eventb.core.label="act15"/>
        <org.eventb.core.action name="(" org.eventb.core.assignment="depTime ≔ {aircraft} ⩤ depTime" org.eventb.core.label="act18"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="depRwy ≔ {aircraft} ⩤ depRwy" org.eventb.core.label="act19"/>
        <org.eventb.core.action name="internal3" org.eventb.core.assignment="readyTime ≔ {aircraft} ⩤ readyTime" org.eventb.core.label="act20"/>
    </org.eventb.core.event>
    <org.eventb.core.variable name="*3" org.eventb.core.identifier="readyTime"/>
    <org.eventb.core.variable name="*4" org.eventb.core.identifier="depTime"/>
    <org.eventb.core.variable name="*5" org.eventb.core.identifier="lastDepTime"/>
    <org.eventb.core.variable name="*6" org.eventb.core.identifier="lastDepBrand"/>
    <org.eventb.core.invariant name="*8" org.eventb.core.label="inv1" org.eventb.core.predicate="readyTime ∈ aircrafts_in_TMA ⇸ ℕ"/>
    <org.eventb.core.invariant name="*9" org.eventb.core.label="inv2" org.eventb.core.predicate="depTime ∈ aircrafts_in_TMA ⇸ ℕ"/>
    <org.eventb.core.invariant name="*:" org.eventb.core.label="inv3" org.eventb.core.predicate="depRwy ∈ aircrafts_in_TMA ⇸ RUNWAY ∧ dom(depRwy) = dom(depTime)"/>
    <org.eventb.core.invariant name="*;" org.eventb.core.label="inv4" org.eventb.core.predicate="lastDepTime ∈ RUNWAY ⇸ ℕ ∧ lastDepBrand ∈ RUNWAY ⇸ WTC&#13;&#10;       ∧ dom(lastDepTime) = dom(lastDepBrand)"/>
    <org.eventb.core.invariant name="*&gt;" org.eventb.core.label="inv6" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a) ∈ {Takingoff, TerminatedT}&#13;&#10;         ⇒ a ∈ dom(depTime) ∧ a ∈ dom(brandof)"/>
    <org.eventb.core.invariant name="*?" org.eventb.core.label="inv7" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a) = ReadyT ⇒ a ∈ dom(readyTime)"/>
    <org.eventb.core.invariant name="*@" org.eventb.core.label="inv8" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a) = Takingoff&#13;&#10;         ⇒ a ∈ dom(clearanceT) ∧ depRwy(a) = clearanceT(a)"/>
    <org.eventb.core.variable name="*F" org.eventb.core.identifier="depRwy"/>
    <org.eventb.core.variable name="*G" org.eventb.core.identifier="clearanceT"/>
    <org.eventb.core.invariant name="*H" org.eventb.core.label="inv14" org.eventb.core.predicate="∀a· a ∈ dom(statusof) ∧ statusof(a) ∈ {ReadyT, ExecutedT} ⇒ a ∈ dom(readyTime)"/>
    <org.eventb.core.variable name="*I" org.eventb.core.identifier="lastlandingBrand"/>
    <org.eventb.core.invariant name="*J" org.eventb.core.label="inv15" org.eventb.core.predicate="lastlandingBrand ∈ RUNWAY ⇸ WTC ∧ dom(lastlandingBrand) = dom(lastlandingtime)"/>
    <org.eventb.core.variable name="*K" org.eventb.core.identifier="TouchdownTime"/>
    <org.eventb.core.variable name="*L" org.eventb.core.identifier="lastlandingtime"/>
    <org.eventb.core.invariant name="*M" org.eventb.core.comment="landing after landing " org.eventb.core.label="inv16" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a)=Landing ∧ a ∈ dom(clearanceL) ∧&#13;&#10;  a ∈ dom(TouchdownTime) ∧ a ∈ dom(brandof) ∧&#13;&#10;  clearanceL(a) ∈ dom(lastlandingtime) ∧ clearanceL(a) ∈ dom(lastlandingBrand)&#13;&#10;⇒ TouchdownTime(a) ≥ lastlandingtime(clearanceL(a)) +&#13;&#10;    Separation_time(lastlandingBrand(clearanceL(a)) ↦ brandof(a))"/>
    <org.eventb.core.invariant name="*N" org.eventb.core.comment="takeoff after landing" org.eventb.core.label="inv17" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a)=Takingoff ∧ a ∈ dom(depTime) ∧&#13;&#10;  a ∈ dom(depRwy) ∧ depRwy(a) ∈ dom(lastlandingtime)&#13;&#10;⇒ depTime(a) ≥ lastlandingtime(depRwy(a)) + RwySep"/>
    <org.eventb.core.invariant name="*O" org.eventb.core.comment="landing after takeoff" org.eventb.core.label="inv18" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a)=Landing ∧ a ∈ dom(clearanceL) ∧&#13;&#10;  a ∈ dom(TouchdownTime) ∧ clearanceL(a) ∈ dom(lastDepTime)&#13;&#10;⇒ TouchdownTime(a) ≥ lastDepTime(clearanceL(a)) + RwySep"/>
    <org.eventb.core.invariant name="*P" org.eventb.core.comment="takeoff after takeoff" org.eventb.core.label="inv19" org.eventb.core.predicate="∀ a · a ∈ aircrafts_in_TMA ∧ statusof(a)=Takingoff ∧ a ∈ dom(depTime) ∧&#13;&#10;  a ∈ dom(depRwy) ∧ a ∈ dom(brandof) ∧&#13;&#10;  depRwy(a) ∈ dom(lastDepTime) ∧ depRwy(a) ∈ dom(lastDepBrand)&#13;&#10;⇒ depTime(a) ≥ lastDepTime(depRwy(a)) +&#13;&#10;    DepDepSep(lastDepBrand(depRwy(a)) ↦ brandof(a))"/>
</org.eventb.core.machineFile>
