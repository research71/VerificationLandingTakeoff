        <org.eventb.core.prPred name="p13" org.eventb.core.predicate="∀l1⦂SLEGS,l2⦂SLEGS,w1⦂WAYPOINT,w2⦂WAYPOINT·l1∈SLEGS∧l2∈SLEGS∧l1≠l2∧legPMS(l1)=legPMS(l2)∧w1∈WAYPOINT∧w2∈WAYPOINT∧w1∈ran(legSeq(l1))∧w2∈ran(legSeq(l2))∧wpDistMerge(w1)&lt;wpDistMerge(w2)⇒legFL(l1)&gt;legFL(l2)"/>
