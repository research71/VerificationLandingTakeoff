            <org.eventb.theory.core.scNewOperatorDefinition name="isqrt" org.eventb.core.label="isqrt" org.eventb.core.predicate="n∈ℕ∧n≥0" org.eventb.core.source="/TheoryABZ2023/Time.tuf|org.eventb.theory.core.theoryRoot#Time|org.eventb.theory.core.newOperatorDefinition#*" org.eventb.theory.core.associative="false" org.eventb.theory.core.commutative="false" org.eventb.theory.core.formulaType="true" org.eventb.theory.core.groupID="org.eventb.core.ast.closed" org.eventb.theory.core.hasError="false" org.eventb.theory.core.notationType="PREFIX" org.eventb.theory.core.type="ℤ" org.eventb.theory.core.wd="(∀k⦂ℤ·(k∈ℕ∧k∗k≤n)∨¬k∈ℕ∨¬k∗k≤n)∧{k⦂ℤ·k∈ℕ∧k∗k≤n ∣ k}≠(∅ ⦂ ℙ(ℤ))∧(∃b⦂ℤ·∀x⦂ℤ·x∈{k⦂ℤ·k∈ℕ∧k∗k≤n ∣ k}⇒b≥x)">
                <org.eventb.theory.core.scOperatorArgument name="n" org.eventb.core.source="/TheoryABZ2023/Time.tuf|org.eventb.theory.core.theoryRoot#Time|org.eventb.theory.core.newOperatorDefinition#*|org.eventb.theory.core.operatorArgument#'" org.eventb.core.type="ℤ"/>
