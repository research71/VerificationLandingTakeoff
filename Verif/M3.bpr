        <org.eventb.core.prPred name="p1" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)&lt;lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒lastMergeTime(PmsMerge(legPMS(legOf(a)))) − mergeTime(a)≥Separation_time(brandof(a) ↦ lastMergeBrand(PmsMerge(legPMS(legOf(a)))))"/>
        <org.eventb.core.prPred name="p335" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
