        <org.eventb.core.prPred name="p172" org.eventb.core.predicate="¬ExecutedL=Takingoff"/>
        <org.eventb.core.prPred name="p223" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·l∈SLEGS∧w∈WAYPOINT∧w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
        <org.eventb.core.prPred name="p261" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.prPred name="p356" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(legOf)∧a∈dom(brandof)∧PmsMerge(legPMS(legOf(a)))=pm⇒current_time+wpDistMerge(legSeq(legOf(aircraft))(legIndex(aircraft)))∗360 ÷ legSpeed − mergeTime(a)≥Separation_time(brandof(a) ↦ brandof(aircraft))"/>
        <org.eventb.core.prPred name="p6" org.eventb.core.predicate="partition(WTC,{Light},{Medium},{Heavy})"/>
