        <org.eventb.core.prPred name="p179" org.eventb.core.predicate="¬TerminatedL=ReadyT"/>
        <org.eventb.core.prPred name="p7" org.eventb.core.predicate="aircraft∈dom(legOf)"/>
        <org.eventb.core.prPred name="p154" org.eventb.core.predicate="¬ScheduledL=ExecutedL"/>
        <org.eventb.core.prPred name="p366" org.eventb.core.predicate="pm ↦ cpOf(aircraft)∈dom(pmCPDist)"/>
        <org.eventb.core.prPred name="p9" org.eventb.core.predicate="clearanceT∈aircrafts_in_TMA ⇸ RUNWAY"/>
        <org.eventb.core.prPred name="p10" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)=lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒brandof(a)=lastMergeBrand(PmsMerge(legPMS(legOf(a))))"/>
        <org.eventb.core.prPred name="p11" org.eventb.core.predicate="current_time∈ℕ"/>
        <org.eventb.core.prPred name="p12" org.eventb.core.predicate="∀b⦂AIRCRAFTS·b∈dom(legIndex)∧b∈dom(legOf)∧b∈dom(legEntryTime)∧legOf(b)=leg⇒legEntryTime(b)≥legEntryTime(aircraft)"/>
        <org.eventb.core.prPred name="p13" org.eventb.core.predicate="∀l1⦂SLEGS,l2⦂SLEGS,w1⦂WAYPOINT,w2⦂WAYPOINT·l1∈SLEGS∧l2∈SLEGS∧l1≠l2∧legPMS(l1)=legPMS(l2)∧w1∈WAYPOINT∧w2∈WAYPOINT∧w1∈ran(legSeq(l1))∧w2∈ran(legSeq(l2))∧wpDistMerge(w1)&lt;wpDistMerge(w2)⇒legFL(l1)&gt;legFL(l2)"/>
        <org.eventb.core.prPred name="p17" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(mergeTime)∧b∈dom(mergeTime)∧a≠b∧a∈dom(legOf)∧b∈dom(legOf)∧a∈dom(brandof)∧b∈dom(brandof)∧PmsMerge(legPMS(legOf(a)))=PmsMerge(legPMS(legOf(b)))∧mergeTime(a)≤mergeTime(b)⇒mergeTime(b) − mergeTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.prPred name="p336" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,p⦂ℤ×ℤ,z⦂ℤ·w∈ran(legSeq(l))∧w ↦ (p ↦ z)∈wppos⇒z=legFL(l)"/>
