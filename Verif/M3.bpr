        <org.eventb.core.prPred name="p1" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)&lt;lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒lastMergeTime(PmsMerge(legPMS(legOf(a)))) − mergeTime(a)≥Separation_time(brandof(a) ↦ lastMergeBrand(PmsMerge(legPMS(legOf(a)))))"/>
        <org.eventb.core.prPred name="p365" org.eventb.core.predicate="∀l⦂SLEGS,w⦂WAYPOINT,x⦂ℤ,y⦂ℤ,z⦂ℤ,mx⦂ℤ,my⦂ℤ,mz⦂ℤ,dx⦂ℤ,dy⦂ℤ·w∈ran(legSeq(l))∧w ↦ (x ↦ y ↦ z)∈wppos∧PmsMerge(legPMS(l)) ↦ (mx ↦ my ↦ mz)∈pmpos∧dx=x − mx∧dy=y − my⇒wpDistMerge(w)∗wpDistMerge(w)≤dx∗dx+dy∗dy∧dx∗dx+dy∗dy&lt;(wpDistMerge(w)+1)∗(wpDistMerge(w)+1)"/>
        <org.eventb.core.prPred name="p245" org.eventb.core.predicate="wpDistMerge∈WAYPOINT → ℕ1"/>
        <org.eventb.core.prPred name="p266" org.eventb.core.predicate="dom(lastEntryTime)=dom(lastEntryBrand)"/>
        <org.eventb.core.prPred name="p166" org.eventb.core.predicate="¬ExecutedT=Takingoff"/>
        <org.eventb.core.prPred name="p439" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(cpTime)∧a∈dom(brandof)∧cpOf(a)=cpOf(aircraft)⇒current_time+wpDistMerge(legSeq(legOf(aircraft))(leglength(legOf(aircraft))))∗360 ÷ legSpeed+pmCPDist(PmsMerge(legPMS(legOf(aircraft))) ↦ cpOf(aircraft))∗360 ÷ legSpeed − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(aircraft))"/>
        <org.eventb.core.prPred name="p282" org.eventb.core.predicate="∀a⦂AIRCRAFTS,b⦂AIRCRAFTS·a∈dom(cpTime)∧b∈dom(cpTime)∧¬a=b∧a∈dom(brandof)∧b∈dom(brandof)∧cpOf(a)=cpOf(b)∧cpTime(a)≤cpTime(b)⇒cpTime(b) − cpTime(a)≥Separation_time(brandof(a) ↦ brandof(b))"/>
        <org.eventb.core.prPred name="p179" org.eventb.core.predicate="¬ScheduledL=ExecutedL"/>
        <org.eventb.core.prPred name="p444" org.eventb.core.predicate="dom(lastcpTime{cpOf(aircraft) ↦ current_time+wpDistMerge(legSeq(legOf(aircraft))(leglength(legOf(aircraft))))∗360 ÷ legSpeed+pmCPDist(PmsMerge(legPMS(legOf(aircraft))) ↦ cpOf(aircraft))∗360 ÷ legSpeed})=dom(lastcpBrand{cpOf(aircraft) ↦ brandof(aircraft)})"/>
        <org.eventb.core.prPred name="p11" org.eventb.core.predicate="clearanceT∈aircrafts_in_TMA ⇸ RUNWAY"/>
        <org.eventb.core.prPred name="p12" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(brandof)∧mergeTime(a)=lastMergeTime(PmsMerge(legPMS(legOf(a))))⇒brandof(a)=lastMergeBrand(PmsMerge(legPMS(legOf(a))))"/>
