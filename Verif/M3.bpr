        <org.eventb.core.prPred name="p375" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(legOf)∧a∈dom(brandof)∧PmsMerge(legPMS(legOf(a)))=pm⇒current_time+wpDistMerge(legSeq(legOf(aircraft))(legIndex(aircraft)))∗360 ÷ legSpeed − mergeTime(a)≥Separation_time(brandof(a) ↦ brandof(aircraft))"/>
