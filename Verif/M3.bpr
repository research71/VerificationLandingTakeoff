        <org.eventb.core.prPred name="p360" org.eventb.core.predicate="∀a⦂AIRCRAFTS·a∈dom(mergeTime)∧a∈dom(legOf)∧PmsMerge(legPMS(legOf(a)))=pm⇒mergeTime(a)&lt;current_time+wpDistMerge(legSeq(leg)(legIndex(aircraft)))∗360 ÷ legSpeed"/>
